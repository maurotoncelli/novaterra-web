---
// src/pages/contatti.astro
import PageTemplate from '../Components/Ui/PageTemplate.astro';
import ContactForm from '../Components/Contact/ContactForm.astro';
import ContactInfo from '../Components/Contact/ContactInfo.astro';
import ContactMap from '../Components/Contact/ContactMap.astro';
import { contactHero } from '../data/contactData';
---

<PageTemplate
  meta={{
    title: "Contatti | Novaterra - Earth Engineering",
    description:
      "Contatta NOVATERRA per preventivi e consulenze. Riccardo Toncelli, movimento terra in Toscana.",
    canonicalHref: "/contatti"
  }}
  hero={contactHero}
>
  <!-- ============================================================
    BANNER MANUTENZIONE — attivo
    Per rimuoverlo: elimina questo blocco <div class="maintenance-banner">...</div>
    e il relativo CSS .maintenance-banner in fondo al file <style>
    ============================================================ -->
  <div class="maintenance-banner">
    <span class="maintenance-icon">⚙</span>
    <span class="maintenance-text">Sito in costruzione — torneremo presto con qualcosa di bello.</span>
  </div>

  <section class="contact-page">
    <!-- Grid 2 colonne: Info | Form -->
    <div class="contact-layout">
      <!-- Colonna Info -->
      <div>
        <span class="subtitle">Informazioni</span>
        <h2 class="section-title">Ci sentiamo. E poi si parte.</h2>
        <div class="contact-info-stack">
          <ContactInfo showHeading={false} />
        </div>
      </div>

      <!-- Colonna Form -->
      <div>
        <span class="subtitle">Richiesta</span>
        <h2 class="section-title">Raccontaci il progetto.</h2>
        <p class="contact-lead">
          Compila il modulo: ti rispondiamo rapidamente con una proposta chiara e operativa.
        </p>
        <ContactForm />
      </div>
    </div>

    <!-- Mappa -->
    <ContactMap />
  </section>
</PageTemplate>

<style>
  .contact-page {
    width: 100%;
  }

  .contact-lead {
    margin-top: 1.25rem;
    margin-bottom: 3rem;
    color: var(--nova-muted);
    line-height: 1.7;
    max-width: 42rem;
  }
  
  .contact-layout {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 4rem;
    margin-bottom: 6rem;
  }

  .contact-info-stack {
    margin-top: 2.25rem;
  }

  /* Tablet: reduce spacing without changing layout */
  @media (max-width: 1024px) {
    .contact-layout {
      gap: 3rem;
      margin-bottom: 5rem;
    }
  }
  
  @media (max-width: 768px) {
    .contact-info-stack {
      margin-top: 1.75rem;
    }

    .contact-lead {
      margin-bottom: 2.25rem;
    }

    .contact-layout {
      grid-template-columns: 1fr;
      gap: 3rem;
    }
  }

  /* ============================================================
    BANNER MANUTENZIONE — CSS
    Da rimuovere insieme al blocco HTML sopra quando il sito torna online
    ============================================================ */
  .maintenance-banner {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 0.75rem;
    background: rgba(205, 92, 47, 0.08);
    border: 1px solid rgba(205, 92, 47, 0.35);
    color: var(--nova-accent);
    font-size: 0.85rem;
    font-weight: 600;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    padding: 0.9rem 1.5rem;
    margin-bottom: 3rem;
  }

  .maintenance-icon {
    font-size: 1rem;
    animation: spin 4s linear infinite;
  }

  @keyframes spin {
    from { transform: rotate(0deg); }
    to { transform: rotate(360deg); }
  }

  @media (max-width: 768px) {
    .maintenance-banner {
      flex-direction: column;
      gap: 0.5rem;
      text-align: center;
      font-size: 0.78rem;
    }
  }
</style>
