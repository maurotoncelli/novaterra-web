---
import ServicePage from '../../views/ServicePage.astro';
import { getAllServiceSlugs, getServiceBySlug } from '../../lib/servicesRepository';

export function getStaticPaths() {
  return getAllServiceSlugs().map((slug) => ({ params: { slug } }));
}

if (!getServiceBySlug(Astro.params.slug!)) return Astro.redirect('/404');
---
<ServicePage />
