---
// src/Components/home/TuscanyCoverage.astro
import TuscanyMap from '../Ui/TuscanyMap.astro';
import { getLocale } from '../../i18n/config';
import { chrome } from '../../i18n/content';

const ui = chrome(getLocale(Astro.url.pathname));
---

<section class="container mx-auto px-[5vw] mt-16 md:mt-32 relative z-10">
  <div class="coverage-grid">
    <div class="coverage-copy reveal-fx">
      <span class="coverage-kicker">{ui.territoryKicker}</span>
      <h3 class="coverage-title">
        {ui.territoryTitle}<br />
        <span class="coverage-accent">{ui.territoryAccent}</span>
      </h3>
      <p class="coverage-desc">{ui.territoryDesc}</p>
    </div>

    <div class="coverage-map reveal-fx">
      <TuscanyMap className="tuscany-map--compact" />
    </div>
  </div>
</section>

<style>
  .coverage-grid {
    display: grid;
    gap: 3rem;
    align-items: center;
  }

  .coverage-kicker {
    display: inline-block;
    font-size: 0.75rem;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    font-weight: 800;
    color: var(--nova-accent);
    margin-bottom: 1rem;
  }

  .coverage-title {
    margin: 0;
    font-size: clamp(2.05rem, 3.2vw, 2.75rem);
    font-weight: 600;
    line-height: 1.12;
    letter-spacing: -0.01em;
    color: white;
  }

  .coverage-accent {
    color: var(--nova-accent);
  }

  .coverage-desc {
    margin-top: 1.25rem;
    margin-bottom: 0;
    max-width: 58ch;
    color: var(--nova-muted);
    font-size: 1.02rem;
    line-height: 1.7;
    font-weight: 300;
  }

  .coverage-map {
    width: 100%;
    display: flex;
    justify-content: flex-start;
    max-width: 560px;
    justify-self: start;
  }

  @media (min-width: 1024px) {
    .coverage-grid {
      grid-template-columns: 1.2fr 0.9fr;
      gap: 2.75rem;
    }
  }

  @media (max-width: 768px) {
    .coverage-grid {
      grid-template-columns: 1.15fr 0.85fr;
      gap: 1rem;
      align-items: start;
    }

    .coverage-kicker {
      margin-bottom: 0.6rem;
      font-size: 0.7rem;
    }

    .coverage-title {
      font-size: 1.45rem;
    }

    .coverage-desc {
      margin-top: 0.75rem;
      font-size: 0.86rem;
      line-height: 1.5;
      max-width: none;
    }

    .coverage-map {
      justify-content: flex-start;
      max-width: 240px;
    }
  }
</style>

