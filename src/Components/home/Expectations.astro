---
import { getLocale } from '../../i18n/config';
import { homeContent } from '../../i18n/content';
import SectionHeader from '../Ui/SectionHeader.astro';

const { expectations, expectationsHeader } = homeContent(getLocale(Astro.url.pathname));
---
<section class="container mx-auto px-[5vw] mt-16 md:mt-32 relative z-10">
    
    <SectionHeader subtitle={expectationsHeader.subtitle} title={expectationsHeader.title} />

    <div class="grid grid-cols-2 sm:grid-cols-2 lg:grid-cols-4 gap-[1px] bg-white/10 border border-white/10 reveal-fx">
        {expectations.map(exp => (
            <div class="bg-nova-bg p-3 md:p-8 hover:bg-nova-surface transition-colors duration-300 flex items-center gap-2 md:gap-4 cursor-none">
                <span class="text-nova-accent text-[0.95rem] md:text-xl">✓</span>
                <span class="text-white font-bold text-[0.72rem] md:text-sm tracking-wide uppercase leading-tight">{exp}</span>
            </div>
        ))}
    </div>
</section>