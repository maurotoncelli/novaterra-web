---
// src/Components/Footer.astro
import { getLocale, pathFor } from '../i18n/config';
import { chrome } from '../i18n/content';

const locale = getLocale(Astro.url.pathname);
const ui = chrome(locale);
---
<footer class="w-full py-16 px-[5vw] border-t border-white/10 bg-nova-bg text-nova-muted text-sm relative z-10 flex flex-col md:flex-row justify-between items-center gap-8">
    
    <div class="text-center md:text-left">
        <p>{ui.legalLine}</p>
        <a href={pathFor("privacy", locale)} class="footer-link inline-block mt-3 text-xs uppercase tracking-widest opacity-70 hover:opacity-100 hover:text-nova-accent transition-colors">
          {ui.privacy}
        </a>
    </div>
    
    <div class="text-center opacity-60 uppercase tracking-widest text-xs">
        {ui.footerCredit}
    </div>

    <!-- Socials -->
    <div class="flex gap-6">
        <a href="#" class="hover:text-nova-accent transition-colors">Instagram</a>
        <a href="#" class="hover:text-nova-accent transition-colors">Linkedin</a>
    </div>
</footer>