---
// src/Components/Contact/ContactForm.astro
import { formConfig } from '../../data/contactData';
---

<!-- Banner successo (visibile quando URL ha ?success=true dopo submission Netlify) -->
<div id="form-success-banner" class="success-banner" hidden aria-live="polite">
  <div class="success-inner">
    <span class="success-icon">✓</span>
    <div class="success-text">
      <strong class="success-title">Messaggio inviato!</strong>
      <p class="success-desc">Riccardo ti risponderà al più presto a <a href="mailto:info@novaterra.work">info@novaterra.work</a></p>
    </div>
    <button class="success-close" type="button" aria-label="Chiudi">✕</button>
  </div>
</div>

<div class="form-wrapper">
  <!--
    Netlify Forms: il form invia via POST standard (non AJAX) → più affidabile.
    Dopo l'invio, Netlify redirige a /contatti?success=true
    Per cambiare email di notifica: Netlify Dashboard → Site Settings → Forms → Form notifications
  -->
  <form
    id="contact-form"
    class="contact-form"
    name="contatto"
    method="POST"
    action="/contatti?success=true"
    data-netlify="true"
    netlify-honeypot="bot-field"
  >
    <!-- Campi obbligatori per Netlify Forms -->
    <input type="hidden" name="form-name" value="contatto" />
    <p class="honeypot" aria-hidden="true">
      <input name="bot-field" tabindex="-1" autocomplete="off" />
    </p>

    {formConfig.fields.map((field) => (
      <div class="input-group">
        <input
          type={field.type}
          id={field.id}
          name={field.id}
          class="input-field"
          placeholder=" "
          required={field.required}
        />
        <label for={field.id} class="input-label">{field.label}</label>
      </div>
    ))}

    <div class="consent">
      <label class="consent-row">
        <input id="privacy-consent" name="privacyConsent" type="checkbox" required />
        <span class="consent-text">
          Ho letto e accetto la <a class="consent-link" href="/privacy-policy">Privacy Policy</a>.
          I dati verranno usati per rispondere alla richiesta e, se applicabile, per analisi statistiche (Google Analytics) e comunicazioni informative/marketing.
          <strong>Non vendiamo i dati a terzi</strong>.
        </span>
      </label>
    </div>
    
    <button type="submit" class="submit-btn">
      {formConfig.submitButton.text}
    </button>
  </form>
</div>

<style>
  .form-wrapper {
    width: 100%;
    padding-top: 0;
  }
  
  .contact-form {
    width: 100%;
  }

  .honeypot {
    display: none !important;
  }
  
  .input-group {
    margin-bottom: 2rem;
  }

  .consent {
    margin-top: 1.25rem;
    margin-bottom: 2rem;
    padding-top: 1.25rem;
    border-top: 1px solid rgba(255, 255, 255, 0.12);
  }

  .consent-row {
    display: grid;
    grid-template-columns: 18px 1fr;
    gap: 14px;
    align-items: start;
    cursor: pointer;
    user-select: none;
  }

  .consent-row input[type="checkbox"] {
    width: 18px;
    height: 18px;
    margin-top: 4px;
    accent-color: var(--nova-accent);
  }

  .consent-text {
    color: var(--nova-muted);
    font-size: 0.92rem;
    line-height: 1.6;
  }

  .consent-link {
    color: var(--nova-text);
    text-decoration: none;
    border-bottom: 1px solid rgba(255, 255, 255, 0.25);
    transition: border-color 200ms ease, color 200ms ease;
  }

  .consent-link:hover {
    color: var(--nova-accent);
    border-color: rgba(205, 92, 47, 0.65);
  }

  /* ── Banner successo ── */
  .success-banner {
    position: fixed;
    bottom: 2rem;
    left: 50%;
    transform: translateX(-50%);
    z-index: 9000;
    width: min(600px, calc(100vw - 2rem));
    background: #1c1b19;
    border: 1px solid rgba(126, 207, 160, 0.5);
    box-shadow: 0 8px 40px rgba(0, 0, 0, 0.6);
    animation: slideUp 0.4s cubic-bezier(0.19, 1, 0.22, 1) forwards;
  }

  @keyframes slideUp {
    from { opacity: 0; transform: translateX(-50%) translateY(20px); }
    to   { opacity: 1; transform: translateX(-50%) translateY(0); }
  }

  .success-inner {
    display: flex;
    align-items: flex-start;
    gap: 1.25rem;
    padding: 1.5rem 1.75rem;
  }

  .success-icon {
    flex-shrink: 0;
    width: 36px;
    height: 36px;
    border-radius: 50%;
    background: rgba(126, 207, 160, 0.15);
    border: 1px solid rgba(126, 207, 160, 0.5);
    color: #7ecfa0;
    font-size: 1.1rem;
    font-weight: 700;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .success-text {
    flex: 1;
  }

  .success-title {
    display: block;
    color: #7ecfa0;
    font-size: 1rem;
    font-weight: 700;
    letter-spacing: 0.05em;
    text-transform: uppercase;
    margin-bottom: 0.4rem;
  }

  .success-desc {
    color: var(--nova-muted);
    font-size: 0.9rem;
    line-height: 1.5;
    margin: 0;
  }

  .success-desc a {
    color: var(--nova-text);
    text-decoration: none;
    border-bottom: 1px solid rgba(255, 255, 255, 0.25);
  }

  .success-close {
    flex-shrink: 0;
    background: none;
    border: none;
    color: var(--nova-muted);
    font-size: 1.1rem;
    cursor: pointer;
    padding: 0;
    line-height: 1;
    transition: color 200ms ease;
  }

  .success-close:hover {
    color: var(--nova-text);
  }

  @media (max-width: 768px) {
    .success-banner {
      bottom: 1rem;
    }

    .success-inner {
      padding: 1.25rem;
      gap: 1rem;
    }

    .success-title {
      font-size: 0.9rem;
    }

    .success-desc {
      font-size: 0.82rem;
    }
  }
</style>

<script>
  // Mostra banner se Netlify ha rediretto qui con ?success=true
  const params = new URLSearchParams(window.location.search);
  if (params.get('success') === 'true') {
    const banner = document.getElementById('form-success-banner');
    if (banner) banner.removeAttribute('hidden');
    // Pulisce l'URL senza ricaricare la pagina
    window.history.replaceState({}, '', window.location.pathname);
    // Scrolla al banner
    banner?.scrollIntoView({ behavior: 'smooth', block: 'end' });
  }

  // Bottone chiudi
  document.querySelector('.success-close')?.addEventListener('click', () => {
    document.getElementById('form-success-banner')?.setAttribute('hidden', '');
  });
</script>
