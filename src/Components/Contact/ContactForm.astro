---
// src/Components/Contact/ContactForm.astro
import { formConfig } from '../../data/contactData';
---

<div class="form-wrapper">
  <!-- Netlify Forms: l'attributo "netlify" + "name" fa intercettare le submissions a Netlify.
       Per ricevere le email su info@novaterra.work:
         Netlify Dashboard → Site Settings → Forms → Form notifications → Add email notification
       Per disattivare o cambiare email, gestisci tutto dalla dashboard Netlify senza toccare codice. -->
  <form
    id="contact-form"
    class="contact-form"
    name="contatto"
    method="POST"
    data-netlify="true"
    netlify-honeypot="bot-field"
    novalidate
  >
    <!-- Campo anti-spam nascosto (Netlify honeypot) -->
    <input type="hidden" name="form-name" value="contatto" />
    <p class="hidden" aria-hidden="true">
      <input name="bot-field" tabindex="-1" autocomplete="off" />
    </p>

    {formConfig.fields.map((field) => (
      <div class="input-group">
        <input
          type={field.type}
          id={field.id}
          name={field.id}
          class="input-field"
          placeholder=" "
          required={field.required}
        />
        <label for={field.id} class="input-label">{field.label}</label>
      </div>
    ))}

    <div class="consent">
      <label class="consent-row">
        <input id="privacy-consent" name="privacyConsent" type="checkbox" required />
        <span class="consent-text">
          Ho letto e accetto la <a class="consent-link" href="/privacy-policy">Privacy Policy</a>.
          I dati verranno usati per rispondere alla richiesta e, se applicabile, per analisi statistiche (Google Analytics) e comunicazioni informative/marketing.
          <strong>Non vendiamo i dati a terzi</strong>.
        </span>
      </label>
    </div>
    
    <button type="submit" class="submit-btn" id="submit-btn">
      {formConfig.submitButton.text}
    </button>

    <!-- Messaggi di feedback -->
    <div id="form-success" class="form-feedback form-feedback--success" aria-live="polite" hidden>
      ✓ Richiesta inviata! Ti risponderemo al più presto.
    </div>
    <div id="form-error" class="form-feedback form-feedback--error" aria-live="polite" hidden>
      ✗ Qualcosa è andato storto. Riprova o scrivici direttamente a <a href="mailto:info@novaterra.work">info@novaterra.work</a>.
    </div>
  </form>
</div>

<style>
  .form-wrapper {
    width: 100%;
    padding-top: 0;
  }
  
  .contact-form {
    width: 100%;
  }
  
  .hidden {
    display: none !important;
  }

  .input-group {
    margin-bottom: 2rem;
  }

  .consent {
    margin-top: 1.25rem;
    margin-bottom: 2rem;
    padding-top: 1.25rem;
    border-top: 1px solid rgba(255, 255, 255, 0.12);
  }

  .consent-row {
    display: grid;
    grid-template-columns: 18px 1fr;
    gap: 14px;
    align-items: start;
    cursor: pointer;
    user-select: none;
  }

  .consent-row input[type="checkbox"] {
    width: 18px;
    height: 18px;
    margin-top: 4px;
    accent-color: var(--nova-accent);
  }

  .consent-text {
    color: var(--nova-muted);
    font-size: 0.92rem;
    line-height: 1.6;
  }

  .consent-link {
    color: var(--nova-text);
    text-decoration: none;
    border-bottom: 1px solid rgba(255, 255, 255, 0.25);
    transition: border-color 200ms ease, color 200ms ease;
  }

  .consent-link:hover {
    color: var(--nova-accent);
    border-color: rgba(205, 92, 47, 0.65);
  }

  .form-feedback {
    margin-top: 1.25rem;
    padding: 1rem 1.25rem;
    font-size: 0.9rem;
    font-weight: 600;
    letter-spacing: 0.03em;
    border: 1px solid;
  }

  .form-feedback--success {
    color: #7ecfa0;
    border-color: rgba(126, 207, 160, 0.35);
    background: rgba(126, 207, 160, 0.06);
  }

  .form-feedback--error {
    color: var(--nova-accent);
    border-color: rgba(205, 92, 47, 0.35);
    background: rgba(205, 92, 47, 0.06);
  }

  .form-feedback--error a {
    color: inherit;
    text-decoration: underline;
  }

  .submit-btn:disabled {
    opacity: 0.5;
    cursor: not-allowed;
  }
</style>

<script>
  const form = document.getElementById('contact-form') as HTMLFormElement | null;
  const submitBtn = document.getElementById('submit-btn') as HTMLButtonElement | null;
  const successMsg = document.getElementById('form-success') as HTMLElement | null;
  const errorMsg = document.getElementById('form-error') as HTMLElement | null;

  if (form) {
    form.addEventListener('submit', async (e: Event) => {
      e.preventDefault();

      if (!submitBtn) return;

      // Stato caricamento
      const originalText = submitBtn.textContent ?? '';
      submitBtn.disabled = true;
      submitBtn.textContent = 'INVIO IN CORSO...';
      if (successMsg) successMsg.hidden = true;
      if (errorMsg) errorMsg.hidden = true;

      try {
        const response = await fetch('/', {
          method: 'POST',
          headers: { 'Content-Type': 'application/x-www-form-urlencoded' },
          body: new URLSearchParams(new FormData(form) as unknown as Record<string, string>).toString(),
        });

        if (response.ok) {
          if (successMsg) successMsg.hidden = false;
          form.reset();
          // Scrolla al messaggio di successo
          successMsg?.scrollIntoView({ behavior: 'smooth', block: 'nearest' });
        } else {
          if (errorMsg) errorMsg.hidden = false;
        }
      } catch {
        if (errorMsg) errorMsg.hidden = false;
      } finally {
        submitBtn.disabled = false;
        submitBtn.textContent = originalText;
      }
    });
  }
</script>
