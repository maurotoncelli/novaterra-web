# Copia in .env (locale) e imposta gli stessi valori su Vercel → Project → Settings → Environment Variables

# ── SMTP casella Netsons (invio email del form contatti) ──
# Host SMTP Netsons (di solito smtp.novaterra.work oppure mail.novaterra.work)
SMTP_HOST=smtp.novaterra.work
# 465 = SSL (consigliato) · 587 = STARTTLS
SMTP_PORT=465
# Casella email completa creata nel cPanel Netsons
SMTP_USER=info@novaterra.work
# Password della casella email
SMTP_PASS=la-password-della-casella

# Destinatario delle notifiche del form
CONTACT_TO_EMAIL=info@novaterra.work
# Mittente (di norma uguale a SMTP_USER)
CONTACT_FROM_EMAIL=info@novaterra.work

# Google Analytics (opzionale) — se era impostata su Netlify, reimpostala qui
# PUBLIC_GA_MEASUREMENT_ID=G-XXXXXXXXXX
